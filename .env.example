# Backend: pi, and only pi. Provider, model and credentials are supplied at
# run time and are never baked into the Agent definition.
AGENT_BACKEND=pi
# Fill with the provider/model actually injected at run time; this public
# template records no machine's real provider or model.
LLM_PROVIDER=<provider>
LLM_MODEL=<model>
# Required: the helper fails closed when no credential is injected.
OPENAI_API_KEY=
# Optional: set only when the chosen provider needs an explicit base URL.
OPENAI_BASE_URL=
# Runtime posture. Widening either of these is a product decision.
HEWO_CAPABILITIES=
HEWO_NETWORK=deny
HEWO_WEATHER_MODE=fixture