# Backend: pi, and only pi. Provider, model and credentials are supplied at
# run time and are never baked into the Agent definition.
AGENT_BACKEND=pi
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PI_MODEL=gpt-5.5
# Runtime posture. Widening either of these is a product decision.
HEWO_CAPABILITIES=
HEWO_NETWORK=deny
HEWO_WEATHER_MODE=fixture
