{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6",
  "permission": {
    "edit": {
      ".agents/memory/**": "allow",
      ".agents/skills/**": "allow",
      ".agents/memory/AGENTS.md": "allow",
      ".agents/skills/**/AGENTS.md": "allow"
    },
    "read": {
      ".agents/memory/**": "allow",
      ".agents/skills/**": "allow"
    },
    "external_directory": {
      ".agents/memory/**": "allow",
      ".agents/skills/**": "allow"
    },
    "bash": "ask",
    "webfetch": "ask"
  }
}
