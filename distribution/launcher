#!/usr/bin/env bash
set -euo pipefail

bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
definition_dir="$bin_dir/../lib/__AGENT_NAME__/agent-definition"

test -f "$definition_dir/opencode.json" || {
  echo "Agent definition is missing: $definition_dir" >&2
  exit 2
}

agent_environment_dir="$bin_dir/../lib/__AGENT_NAME__/environment"
if [[ -d "$agent_environment_dir/bin" ]]; then
  export PATH="$agent_environment_dir/bin:$PATH"
fi

backend="${AGENT_BACKEND:-${HEWO_BACKEND:-pi}}"
provider="${LLM_PROVIDER:-}"
model="${LLM_MODEL:-}"
variant="${LLM_VARIANT:-}"
mode="run"
passthrough=()

usage() {
  cat <<'EOF'
Usage: __AGENT_NAME__ [OPTIONS] [TASK]
       __AGENT_NAME__ --backend codex|claude|opencode|pi [TASK]
       __AGENT_NAME__ --tui [OPTIONS]

Backends:
  pi        pi coding agent CLI (default); provider and model are supplied at runtime.
  opencode  OpenCode CLI; provider and model are supplied at runtime.
  codex     Codex CLI; model is supplied at runtime.
  claude    Claude Code CLI; model is supplied at runtime.

Options:
  --backend NAME   Select the coding-agent backend.
  --provider NAME  Provider name (required by OpenCode and pi); ignored by Codex/Claude Code.
  --model NAME     Backend model; supplied by the user/platform when needed.
  --variant NAME   OpenCode model variant.
  --tui            Start the selected backend's interactive interface.
  -h, --help       Show this help.
  -v, --version    Show the installed Agent version.

The execution backend, provider, model, and credentials are supplied at
runtime. OpenCode uses its selected provider key or an explicit auth store;
Codex and Claude Code use their own credential namespaces; pi uses the
selected provider's credentials. No provider is required by the Agent runtime.
EOF
}

while (($#)); do
  case "$1" in
    --backend|-b) backend="${2:?missing value for --backend}"; shift 2 ;;
    --provider) provider="${2:?missing value for --provider}"; shift 2 ;;
    --model|-m) model="${2:?missing value for --model}"; shift 2 ;;
    --variant) variant="${2:?missing value for --variant}"; shift 2 ;;
    --tui) mode="tui"; shift ;;
    --help|-h) usage; exit 0 ;;
    --version|-v)
      sed -n 's/.*"version":"\([^"]*\)".*/\1/p' "$bin_dir/../lib/__AGENT_NAME__/release-manifest.json" | head -n 1
      exit 0
      ;;
    --) shift; passthrough+=("$@"); break ;;
    *) passthrough+=("$1"); shift ;;
  esac
done

case "$backend" in
  open-code) backend="opencode" ;;
  claude-code) backend="claude" ;;
  pi-coding-agent) backend="pi" ;;
esac

runtime_bin() {
  local name="$1"
  local bundled="$bin_dir/../lib/__AGENT_NAME__/runtimes/$name/node_modules/.bin/$name"
  if [[ -x "$bundled" ]]; then
    printf '%s\n' "$bundled"
  else
    command -v "$name" || true
  fi
}

opencode_bin="$(runtime_bin opencode)"
codex_bin="$(runtime_bin codex)"
claude_bin="$(runtime_bin claude)"
pi_bin="$(runtime_bin pi)"

require_backend() {
  case "$backend" in
    opencode)
      [[ -n "$provider" ]] || { echo "--provider or LLM_PROVIDER is required for OpenCode" >&2; exit 2; }
      key_variable="$(printf '%s' "$provider" | tr '[:lower:]-.' '[:upper:]__')_API_KEY"
      if [[ -z "${!key_variable:-}" && "${AGENT_AUTH_STORE:-}" != 1 ]]; then
        echo "$key_variable is required (or provide an explicit runtime auth store)" >&2
        exit 2
      fi
      [[ -n "$opencode_bin" ]] || { echo "OpenCode runtime is not installed" >&2; exit 2; }
      export OPENCODE_CONFIG="$definition_dir/opencode.json"
      export OPENCODE_CONFIG_DIR="$definition_dir"
      ;;
    codex)
      if [[ -z "${OPENAI_API_KEY:-}" && "${CODEX_AUTH_STORE:-}" != 1 ]]; then
        echo "OPENAI_API_KEY is required (or provide an explicit Codex auth store)" >&2
        exit 2
      fi
      [[ -n "$codex_bin" ]] || { echo "Codex CLI is not installed" >&2; exit 2; }
      export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
      ;;
    claude)
      if [[ -z "${ANTHROPIC_API_KEY:-}" && -z "${ANTHROPIC_AUTH_TOKEN:-}" && -n "${ANTHROPIC_API_KEY_FILE:-}" ]]; then
        [[ -r "$ANTHROPIC_API_KEY_FILE" ]] || { echo "Claude API key file is not readable" >&2; exit 2; }
        export ANTHROPIC_API_KEY="$(<"$ANTHROPIC_API_KEY_FILE")"
      fi
      if [[ -z "${ANTHROPIC_API_KEY:-}" && -z "${ANTHROPIC_AUTH_TOKEN:-}" && "${CLAUDE_AUTH_STORE:-}" != 1 ]]; then
        echo "ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN is required (or provide an explicit Claude auth store)" >&2
        exit 2
      fi
      [[ -n "$claude_bin" ]] || { echo "Claude Code CLI is not installed" >&2; exit 2; }
      export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
      ;;
    pi)
      [[ -n "$provider" ]] || { echo "--provider or LLM_PROVIDER is required for pi" >&2; exit 2; }
      key_variable="$(printf '%s' "$provider" | tr '[:lower:]-.' '[:upper:]__')_API_KEY"
      if [[ -z "${!key_variable:-}" && "${PI_AUTH_STORE:-}" != 1 ]]; then
        echo "$key_variable is required for pi (or provide an explicit pi auth store)" >&2
        exit 2
      fi
      [[ -n "$pi_bin" ]] || { echo "pi runtime is not installed" >&2; exit 2; }
      export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
      ;;
  esac
}

backend_model="${model:-}"
if [[ "$backend_model" == */* ]]; then
  backend_model="${backend_model#*/}"
fi

runtime_context() {
  local file
  cat "$definition_dir/identity.md"
  while IFS= read -r file; do
    cat "$file"
  done < <(find "$definition_dir/knowledge" "$definition_dir/skills" "$definition_dir/workflows" \
    -type f -name '*.md' ! -name AGENTS.md -print | sort)
}

require_backend

case "$backend" in
  opencode)
    model_args=()
    if [[ -n "$model" ]]; then
      if [[ "$model" == */* ]]; then
        model_ref="$model"
      else
        model_ref="$provider/$model"
      fi
      model_args=(--model "$model_ref")
    fi
    [[ -n "$variant" ]] && model_args+=(--variant "$variant")
    if [[ "$mode" == tui || ${#passthrough[@]} -eq 0 ]]; then
      exec "$opencode_bin" "${model_args[@]}" "${passthrough[@]}"
    fi
    format_args=()
    [[ -n "${AGENT_OUTPUT_FORMAT:-}" ]] && format_args=(--format "$AGENT_OUTPUT_FORMAT")
    exec "$opencode_bin" run "${model_args[@]}" "${format_args[@]}" "${passthrough[@]}"
    ;;
  codex)
    [[ -n "$backend_model" ]] || backend_model="${CODEX_MODEL:-}"
    codex_sandbox="${CODEX_SANDBOX_MODE:-workspace-write}"
    case "$codex_sandbox" in
      read-only|workspace-write|danger-full-access) ;;
      *) echo "unsupported Codex sandbox mode: $codex_sandbox" >&2; exit 2 ;;
    esac
    model_args=()
    [[ -n "$backend_model" ]] && model_args+=(--model "$backend_model")
    model_args+=(--sandbox "$codex_sandbox")
    runtime_instructions="$(runtime_context)"
    if [[ "$mode" == tui || ${#passthrough[@]} -eq 0 ]]; then
      codex_initial="$runtime_instructions"
      [[ ${#passthrough[@]} -gt 0 ]] && codex_initial+=$'\n\nInitial user task:\n'"${passthrough[*]}"
      exec "$codex_bin" "${model_args[@]}" "$codex_initial"
    fi
    codex_prompt="$runtime_instructions

User task:
${passthrough[*]}"
    codex_args=(exec --skip-git-repo-check --ephemeral "${model_args[@]}" "$codex_prompt")
    [[ "${AGENT_OUTPUT_FORMAT:-}" == json ]] && codex_args=("${codex_args[@]:0:1}" --json "${codex_args[@]:1}")
    exec "$codex_bin" "${codex_args[@]}"
    ;;
  claude)
    [[ -n "$backend_model" ]] || backend_model="${CLAUDE_MODEL:-}"
    model_args=()
    [[ -n "$backend_model" ]] && model_args+=(--model "$backend_model")
    runtime_instructions="$(runtime_context)"
    if [[ "$mode" == tui || ${#passthrough[@]} -eq 0 ]]; then
      claude_tui_args=(--append-system-prompt "$runtime_instructions" "${model_args[@]}")
      [[ ${#passthrough[@]} -gt 0 ]] && claude_tui_args+=("${passthrough[*]}")
      exec "$claude_bin" "${claude_tui_args[@]}"
    fi
    claude_args=(-p "${passthrough[*]}" --append-system-prompt "$runtime_instructions" --no-session-persistence "${model_args[@]}")
    [[ -n "${AGENT_OUTPUT_FORMAT:-}" ]] && claude_args+=(--output-format "$AGENT_OUTPUT_FORMAT")
    exec "$claude_bin" "${claude_args[@]}"
    ;;
  pi)
    [[ -n "$model" ]] || model="${PI_MODEL:-}"
    pi_args=(--provider "$provider" --append-system-prompt "$(runtime_context)")
    [[ -n "$model" ]] && pi_args+=(--model "$model")
    [[ -n "${AGENT_OUTPUT_FORMAT:-}" ]] && pi_args+=(--mode "$AGENT_OUTPUT_FORMAT")
    if [[ "$mode" == tui || ${#passthrough[@]} -eq 0 ]]; then
      exec "$pi_bin" "${pi_args[@]}" "${passthrough[@]}"
    fi
    pi_args+=(--print --no-session)
    exec "$pi_bin" "${pi_args[@]}" "${passthrough[@]}"
    ;;
  *)
    echo "unsupported backend: $backend (expected opencode, codex, claude, or pi)" >&2
    exit 2
    ;;
esac
