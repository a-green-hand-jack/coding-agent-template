#!/usr/bin/env bash
set -euo pipefail
provider="${LLM_PROVIDER:-openai}"
key_variable="$(printf '%s' "$provider" | tr '[:lower:]-.' '[:upper:]__')_API_KEY"
test -n "${!key_variable:-}" || { echo "$key_variable is required" >&2; exit 2; }
export OPENCODE_CONFIG="$HOME/.local/lib/__AGENT_NAME__/agent-definition/opencode.json"
model="${LLM_MODEL:-}"
provider="${LLM_PROVIDER:-}"
model_args=()
if [[ -n "$provider" && -n "$model" ]]; then
  model_args=(--model "$provider/$model")
fi
exec opencode run "${model_args[@]}" "$@"
