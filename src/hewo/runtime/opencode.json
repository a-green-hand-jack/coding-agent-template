{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "hewo",
  "agent": {
    "hewo": {
      "description": "A minimal Agent for validating the OpenCode template infrastructure.",
      "prompt": "{file:./identity.md}",
      "tools": {
        "skill": true
      }
    }
  },
  "skills": ["./skills"],
  "instructions": ["./knowledge/*.md", "./workflows/*.md"],
  "share": "disabled",
  "autoupdate": false
}
